<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modelled on PySimpleGUI's DarkAmber, the third theme bibleGUI.py called out. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#2C2825"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFC300"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#3A342E"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#F5D77A"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#705C1E"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#8A7228"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#564716"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFE9A8"/>

    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#3A342E"/>
    <SolidColorBrush x:Key="ComboTextBrush" Color="#F5D77A"/>
    <SolidColorBrush x:Key="ComboHoverBrush" Color="#4A423A"/>

    <SolidColorBrush x:Key="CounterBackgroundBrush" Color="#332E29"/>
    <SolidColorBrush x:Key="CounterTextBrush" Color="#C9A94E"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#5A4E30"/>
    <SolidColorBrush x:Key="VerseReferenceBrush" Color="#A08A4A"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#8A6A14"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#4A422E"/>

</ResourceDictionary>
