<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modelled on PySimpleGUI's DarkGray3, listed as "a nice one" in bibleGUI.py. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#212121"/>
    <SolidColorBrush x:Key="TextBrush" Color="#D6D6D6"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#E8E8E8"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#4C4C4C"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#E8E8E8"/>

    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="ComboTextBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ComboHoverBrush" Color="#4C4C4C"/>

    <SolidColorBrush x:Key="CounterBackgroundBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="CounterTextBrush" Color="#B9B9B9"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="VerseReferenceBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#7A6320"/>
    <SolidColorBrush x:Key="WordsOfChristBrush" Color="#F47067"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#454545"/>

</ResourceDictionary>
