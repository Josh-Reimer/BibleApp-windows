<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The classic look: PySimpleGUI's "green" theme, which the original app selected
        with sg.theme('green'). If the shade is off from what you remember, these six
        brushes are the only place to change it.
    -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#82A459"/>
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>

    <!-- Inputs and the reading pane share the theme's INPUT colour. -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#D8D584"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#000000"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#517A4E"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#628F5E"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#41603F"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>

    <!-- The combo boxes were explicitly background_color='silver' in the original. -->
    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="ComboTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ComboHoverBrush" Color="#D4D4D4"/>

    <!-- The result-count box: disabled_readonly_background_color='lightgrey'. -->
    <SolidColorBrush x:Key="CounterBackgroundBrush" Color="#D3D3D3"/>
    <SolidColorBrush x:Key="CounterTextBrush" Color="#000000"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#41603F"/>
    <SolidColorBrush x:Key="VerseReferenceBrush" Color="#5C6B3A"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#F5B942"/>
    <SolidColorBrush x:Key="WordsOfChristBrush" Color="#B00000"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#B7C98F"/>

</ResourceDictionary>
